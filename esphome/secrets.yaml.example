# Secrets Configuration Example for Hisense AC
# Copy this file to secrets.yaml and fill in your actual values

# WiFi Configuration
wifi_ssid: "Your_WiFi_SSID"
wifi_password: "Your_WiFi_Password"

# Access Point (Fallback Hotspot) Password
ap_password: "FallbackPassword123"

# Home Assistant API Encryption Key
# Generate with: openssl rand -base64 32
api_encryption_key: "your_base64_encoded_32_byte_key_here="

# OTA Update Password
ota_password: "your_ota_password"

# Web Server Authentication
web_username: "admin"
web_password: "your_web_password"

# Optional: Static IP Configuration
# Uncomment and configure if needed
# static_ip: "192.168.1.100"
# gateway: "192.168.1.1"
# subnet: "255.255.255.0"
# dns1: "192.168.1.1"
# dns2: "8.8.8.8"